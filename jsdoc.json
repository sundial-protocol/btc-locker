{
  "source": {
    "include": "./src/",
    "includePattern": "\\.(js)$",
    "recursive": true
  },
  "opts": {
    "destination": "./docs/"
  },
  "plugins": [
    "plugins/markdown"
  ],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "markdown": {
    "parser": "gfm"
  },
  "docdash": {
    "static": true,
    "sort": true
  }
}