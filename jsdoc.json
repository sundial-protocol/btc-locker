{
  "source": {
    "include": ["./src/", "./src/locker/"],
    "includePattern": "\\.(js)$",
    "recursive": true
  },
  "opts": {
    "destination": "./docs/"
  },
  "plugins": ["plugins/markdown"],
  "sourceType": "module",
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "markdown": {
    "parser": "gfm"
  },
  "docdash": {
    "static": true,
    "sort": true
  }
}
