{
  "name": "btc-locker-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/readme/run-badged-command.mjs build \"turbo run build\"",
    "test": "node scripts/readme/run-badged-command.mjs tests \"turbo run test\"",
    "test:coverage": "node scripts/readme/run-badged-command.mjs coverage \"turbo run test:coverage\"",
    "lint": "node scripts/readme/run-badged-command.mjs lint \"turbo run lint\"",
    "type-check": "node scripts/readme/run-badged-command.mjs type-check \"turbo run type-check\"",
    "cli": "npm run start --workspace=packages/cli",
    "cli-link": "npm link --workspace=packages/cli",
    "docs": "typedoc",
    "demo": "npm run start --workspace=packages/demo",
    "demo:dev": "npm run dev --workspace=packages/demo",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "test-all": "npm run type-check && npm run lint && npm run build && npm run test:coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "turbo": "^2.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
