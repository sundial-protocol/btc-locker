{
  "name": "@sundial-protocol/btc-locker",
  "version": "1.0.1",
  "description": "A comprehensive Bitcoin timelock script library for creating and managing time-locked transactions",
  "main": "src/index.js",
  "browser": "dist/btc-locker.bundle.js",
  "types": "types/index.d.ts",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "docs": "jsdoc src/*.js -d docs",
    "prepare": "npm run build",
    "example": "node examples/basic-usage.js",
    "cli": "node bin/btc-locker",
    "demo": "node demo/demo-server.js",
    "demo:dev": "nodemon demo/demo-server.js",
    "start": "node demo/demo-server.js"
  },
  "keywords": [
    "bitcoin",
    "timelock",
    "script",
    "cryptocurrency",
    "blockchain",
    "p2sh",
    "hodl",
    "escrow"
  ],
  "author": "Sundial Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sundial-protocol/btc-locker.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": {
    "url": "https://github.com/sundial-protocol/btc-locker/issues"
  },
  "homepage": "https://github.com/sundial-protocol/btc-locker#readme",
  "bin": {
    "btc-locker": "./bin/btc-locker"
  },
  "dependencies": {
    "bip32": "^4.0.0",
    "bitcoinjs-lib": "^6.1.5",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "ecpair": "^2.1.0",
    "express": "^4.22.1",
    "inquirer": "^8.2.6",
    "tiny-secp256k1": "^2.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "files": [
    "src/",
    "dist/",
    "types/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error"
    }
  }
}
