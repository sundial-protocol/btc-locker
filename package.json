{
  "name": "@sundial-protocol/btc-locker",
  "version": "1.3.1",
  "description": "A comprehensive Bitcoin timelock script library for creating and managing time-locked transactions",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && webpack --mode production",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/fix-imports.mjs",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir dist/cjs",
    "build:dev": "npm run build:esm && webpack --mode development",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "docs": "typedoc --tsconfig tsconfig.docs.json src/index.ts",
    "docs:swagger": "node -e \"console.log('Swagger docs available at: http://localhost:3000/api-docs')\"",
    "prepare": "npm run build",
    "example": "node examples/basic-usage.js",
    "cli": "node bin/btc-locker",
    "demo": "node demo/demo-server.js",
    "demo:dev": "node --watch demo/demo-server.js",
    "start": "node demo/demo-server.js"
  },
  "keywords": [
    "bitcoin",
    "timelock",
    "script",
    "cryptocurrency",
    "blockchain",
    "p2sh",
    "hodl",
    "escrow"
  ],
  "author": "Sundial Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sundial-protocol/btc-locker.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bugs": {
    "url": "https://github.com/sundial-protocol/btc-locker/issues"
  },
  "homepage": "https://github.com/sundial-protocol/btc-locker#readme",
  "bin": {
    "btc-locker": "./bin/btc-locker"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "bip32": "^5.0.0",
    "bitcoinjs-lib": "^7.0.0",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "ecpair": "^2.1.0",
    "express": "^4.22.1",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-loader": "^9.1.3",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "node-fetch": "^2.7.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "tsx": "^4.7.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.3.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "yamljs": "^0.3.0"
  },
  "files": [
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.test.json"
        }
      ]
    },
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/coverage/",
      "/docs/"
    ]
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "off",
      "@typescript-eslint/no-unused-vars": "error"
    }
  }
}
