{
  "name": "@sundial-protocol/btc-runes",
  "version": "0.1.0",
  "description": "Bitcoin Runes primitives: runestone encode and decode checked against ord, rune names, rune ids and varints. No dependencies.",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.build.json --module commonjs --outDir dist/cjs && node ../../scripts/mark-cjs.mjs dist/cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "bitcoin",
    "runes",
    "runestone",
    "ord",
    "ordinals"
  ],
  "author": "Sundial Protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sundial-protocol/btc-locker.git",
    "directory": "packages/runes"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "bitcoinjs-lib": "^7.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "src/",
    "dist/",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
